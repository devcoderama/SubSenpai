# Caddy — reverse proxy + HTTPS otomatis (Let's Encrypt) di depan backend Go.
# Sesuai rancangan deployment STRUKTUR.md Bagian 12 & kompresi O13.

api.subsenpai.app {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
}

# Panel admin: website terpisah khusus admin, di VPS yang sama,
# hanya untuk akun role='admin' (diperiksa ulang di backend).
admin.subsenpai.app {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}
