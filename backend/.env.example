# Contoh konfigurasi backend SubSenpai (salin ke /etc/subsenpai/backend.env di VPS, izin 600)
# Nilai asli TIDAK PERNAH masuk repo.

# HTTP
PORT=8080

# Database PostgreSQL lokal di VPS
DATABASE_URL=postgres://subsenpai:GANTI_PASSWORD@localhost:5432/subsenpai?sslmode=disable

# Sesi enkripsi xdata (handshake ECDH) — masa berlaku sesi maksimum (jam)
SESSION_TTL_HOURS=24

# Auth (dipakai mulai Fase 3) — kunci tanda tangan JWT sesi backend
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG

# Kunci API transkripsi subtitle (Fase 2) — Groq/OpenAI Whisper

# ImgBB (gambar chat & stiker pribadi) — kunci hanya di server
IMGBB_API_KEY=

# Cloudflare R2 (poster, halaman komik, SRT, stiker katalog)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Pembayaran (Fase 4) — Midtrans/Xendit + GoPay Merchant pihak ketiga
MIDTRANS_SERVER_KEY=
XENDIT_SECRET_KEY=
GOPAY_MERCHANT_TOKEN=
